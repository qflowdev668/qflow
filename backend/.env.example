# Ask QFlow. Server-only. Put the same values in the repo-root .env.local (that file is what FastAPI loads).
# Never expose the token to the browser or commit a real token.
# Default model: @cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LLAMA_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
