{
  "name": "qflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd backend && python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "next dev --webpack",
    "dev:full": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev\"",
    "prebuild:web": "node scripts/check-env.mjs",
    "build:web": "node scripts/run-next-build.mjs",
    "build": "npm run build:web",
    "start": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:a11y": "jest --testPathPatterns=accessibility",
    "test:api": "jest --testPathPatterns=api",
    "test:staff-flow": "node scripts/verify-staff-flow.mjs",
    "test:api:python": "cd backend && python -m pytest -q",
    "test:perf": "lhci autorun",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "test:report": "jest --coverage --coverageReporters=html",
    "check:supabase": "node scripts/check-supabase.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "pwa:vapid": "npx web-push generate-vapid-keys",
    "db:link": "npx supabase link --project-ref wotmaediyoapavlnhtmt",
    "db:push": "npx supabase db push",
    "db:backup": "npx supabase db dump -f backups/qflow-$(date +%Y-%m-%d).sql",
    "functions:deploy": "npx supabase functions deploy push-dispatch"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
