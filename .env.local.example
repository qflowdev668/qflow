# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Required for POPIA export/delete (/api/user/*),
# staff create (/api/admin/staff), OTP, and push fan-out.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — staff/admin OTP + password reset emails
# Sandbox sender onboarding@resend.dev ONLY delivers to your Resend account email.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=QFlow <onboarding@resend.dev>
# Redirect all OTP/reset mail here (honored whenever set — local or production).
# Needed while Resend is still in test mode (onboarding@resend.dev).
RESEND_DEV_REDIRECT_TO=qflowdev668@gmail.com
# After verifying a domain at resend.com/domains:
# RESEND_FROM_EMAIL=QFlow <noreply@yourdomain.co.za>
# Remove RESEND_DEV_REDIRECT_TO so real staff emails receive codes.

# Bootstrap super-admin cellphone OTP (never removable). Additional admins:
# Admin console → Manage Admins (/admin/admins) → admin_accounts table.
ADMIN_OTP_PHONE=0655374811
ADMIN_OTP_EMAIL=qflowdev668@gmail.com

# Web Push (PWA) — regenerate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BDTNeQjkIPNsp5dYnxi9fYw8vjvkHawwtwQhZ8SvP4pSgOO_3VhYNXZ95FcuoUqDIV5yA-D98ZhX9WDAXgoDOfw
VAPID_PRIVATE_KEY=Mk836aryGxllugyYOjMlNgwJ0-3AvzfkxypeOrg5AWQ
VAPID_SUBJECT=mailto:qflowdev668@gmail.com
# Shared secret for DB webhook / pg_net → POST /api/push/dispatch
PUSH_DISPATCH_SECRET=qflow-push-dispatch-change-me

# FastAPI is the app server (npm run dev). UI is built with `npm run build:web` and served from /out.
NEXT_PUBLIC_APP_URL=https://useqflow.app
# NEXT_PUBLIC_API_URL=   # leave empty when UI and API share one host (production + local :8000)

# Comma-separated browser origins allowed by FastAPI CORS (no trailing slashes).
ALLOWED_ORIGINS=https://useqflow.app
# Local dev example:
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:8000
# ALLOWED_ORIGINS=http://127.0.0.1:8000

# Upstash Redis — distributed OTP rate limits (optional; falls back to in-memory locally)
# Create a free Redis DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Optional — for npm run db:backup (or use linked project + password prompt)
# SUPABASE_DB_PASSWORD=your-db-password
# SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
